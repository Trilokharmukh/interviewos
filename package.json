{
  "name": "interviewos",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts *.mjs README.md .github/workflows/*.yml"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
